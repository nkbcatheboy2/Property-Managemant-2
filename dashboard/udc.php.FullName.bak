                            <td><?= htmlspecialchars($item['status']) ?></td>
                            <td>₹<?= number_format($item['price'], 2) ?></td>
                            <td><a href="property_detail.php?id=<?= $item['id'] ?>" class="btn btn-sm btn-primary">Open</a></td>
